# Copy this file to .env.docker and fill all required values.
# .env.docker is ignored by Git.

JDDBMS_META_DB_URL=jdbc:dm://host.docker.internal:5236/JDDBMS?useUnicode=true&characterEncoding=UTF-8
JDDBMS_META_DB_USERNAME=JDDBMS
JDDBMS_META_DB_PASSWORD=

# Optional. When blank, the backend generates independent random values on first
# start and stores them in the private app-data Docker volume.
JDDBMS_TOKEN_SECRET=
JDDBMS_DATASOURCE_ENCRYPTION_KEY=

JDDBMS_WEB_PORT=8080
JDDBMS_API_PORT=28080
JDDBMS_LOG_LEVEL=info
