FROM jddbms-arm64-base-java:8

RUN apk add --no-cache fontconfig ttf-dejavu \
    && addgroup -S -g 10001 jddbms \
    && adduser -S -D -H -h /app -u 10001 -G jddbms jddbms \
    && mkdir -p /app/.jddms/config /app/.jddms/cache /data/jddbms/uploadUrl /home/ruoyi/logs \
    && chown -R jddbms:jddbms /app /data/jddbms /home/ruoyi
COPY --chown=10001:10001 app/jddbms.jar /app/jddbms.jar
COPY --chown=10001:10001 assets/jar/ /app/assets/jar/
COPY --chown=10001:10001 VERSION.json /app/VERSION.json
COPY --chown=10001:10001 docker/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod 0755 /app/entrypoint.sh
USER jddbms
WORKDIR /app
ENV HOME=/app \
    JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -XX:MaxRAMPercentage=75.0" \
    DBMS_PROFILE=/data/jddbms \
    PIGENHOLE_UPLOADURL=/data/jddbms/uploadUrl \
    SPRING_DEVTOOLS_RESTART_ENABLED=false
EXPOSE 28080
HEALTHCHECK --interval=15s --timeout=5s --start-period=5m --retries=20 \
    CMD wget -q -O /dev/null http://127.0.0.1:28080/captchaImage || exit 1
ENTRYPOINT ["/app/entrypoint.sh"]
