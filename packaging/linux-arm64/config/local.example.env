# start.sh copies this file to local.env on first startup.
# Use single quotes around values; escape any embedded single quote for Bash.
# Encryption keys are managed automatically in data/.secrets/runtime.env.
JDDBMS_REDIS_HOST='127.0.0.1'
JDDBMS_REDIS_PORT='6379'
JDDBMS_REDIS_PASSWORD=''
JDDBMS_BACKEND_PORT='28080'
JDDBMS_FRONTEND_PORT='18081'
JDDBMS_DATA_DIR='./data/h2'
# Platform metadata storage: h2 (embedded, default) or dm (existing external metadata database).
# External DM must already contain the platform schema/data; startup does not initialize or migrate it.
JDDBMS_META_DB_TYPE='h2'
JDDBMS_META_DB_URL=''
JDDBMS_META_DB_USERNAME=''
JDDBMS_META_DB_PASSWORD=''
JDDBMS_JAVA_XMS='256m'
JDDBMS_JAVA_XMX='1024m'
JDDBMS_DM_EXPORT_TOOL=''
JDDBMS_DM_IMPORT_TOOL=''
JDDBMS_ORACLE_EXPORT_TOOL=''
JDDBMS_ORACLE_IMPORT_TOOL=''
